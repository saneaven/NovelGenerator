# Production (VPS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-prod
POSTGRES_DB=novel_buds

# Backend secrets (MUST be stable; changing them breaks sessions)
JWT_SECRET_KEY=change-me-prod
# MUST be URL-safe base64 32-byte key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-prod
APP_DOMAIN=novelbuds.com

# Demo mode (required for first-run guided mode)
DEMO_MODE_OPENROUTER_API_KEY=change-me-demo-openrouter-key
DEMO_MODE_OPENROUTER_MODEL=openai/gpt-5-mini
DEMO_MODE_CONTEXT_WINDOW_TOKENS=32000
# Optional positive integer. Leave empty to use the provider default.
DEMO_MODE_MAX_OUTPUT_TOKENS=
DEMO_MODE_TEMPERATURE=0.7
# Supported: off, model
DEMO_MODE_THINKING_MODE=off
# Supported: none, minimal, low, medium, high, xhigh, max
# Only used when DEMO_MODE_THINKING_MODE=model.
DEMO_MODE_THINKING_EFFORT=medium

# Asset storage
ASSET_STORAGE_BACKEND=s3
LOCAL_ASSET_STORAGE_PATH=

# S3 asset storage
S3_BUCKET_NAME=novel-buds-assets
S3_REGION=us-west-2
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# Asset quota (bytes)
DEFAULT_STORAGE_QUOTA_BYTES=524288000
STORAGE_USAGE_RECONCILER_ENABLED=1
STORAGE_USAGE_RECONCILER_INTERVAL_SECONDS=300
STORAGE_USAGE_RECONCILER_BATCH_SIZE=100
STORAGE_USAGE_RECONCILER_STALE_AFTER_SECONDS=86400
STORAGE_USAGE_RECONCILER_ADVISORY_LOCK_KEY=84512001

# Frontend
VITE_API_URL=
