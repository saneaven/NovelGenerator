# Production (VPS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-prod
POSTGRES_DB=novel_buds

# Backend secrets (MUST be stable; changing them breaks sessions)
JWT_SECRET_KEY=change-me-prod
# MUST be URL-safe base64 32-byte key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-prod
APP_DOMAIN=novelbuds.com

# S3 asset storage
S3_BUCKET_NAME=novel-buds-assets
S3_REGION=us-west-2
# Leave empty to use the default regional S3 endpoint
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# Asset quota (bytes)
DEFAULT_STORAGE_QUOTA_BYTES=524288000
STORAGE_USAGE_RECONCILER_ENABLED=1
STORAGE_USAGE_RECONCILER_INTERVAL_SECONDS=300
STORAGE_USAGE_RECONCILER_BATCH_SIZE=100
STORAGE_USAGE_RECONCILER_STALE_AFTER_SECONDS=86400
STORAGE_USAGE_RECONCILER_ADVISORY_LOCK_KEY=84512001

# Frontend
VITE_API_URL=
