{
  "version": "0.1.0",
  "catalog": {
    "variables": {
      "language": {
        "description": "Human readable language label the assistant should use in its reply.",
        "type": "string",
        "source": "Derived from requested output language or defaults applied by context builders.",
        "example": "English"
      },
      "functionInstructions": {
        "description": "Rendered markdown describing available function calls for the current chat mode.",
        "type": "string",
        "source": "Chat function instruction templates resolved per mode.",
        "example": "## Available Functions\\n- `manage_story_objects` …"
      },
      "categoryName": {
        "description": "Display name for the story object category being edited.",
        "type": "string",
        "source": "Story object edit context (e.g., Character, Location).",
        "example": "Character"
      },
      "editScope": {
        "description": "Short description of the scope of story object edits.",
        "type": "string",
        "source": "Story object edit context (entire category vs targeted item).",
        "example": "a specific item"
      },
      "chapterName": {
        "description": "Name of the chapter the assistant is editing or generating.",
        "type": "string",
        "source": "Chapter edit prompt context.",
        "example": "Chapter 12 – The Storm"
      },
      "sourceLanguage": {
        "description": "Language of the source material that should be translated.",
        "type": "string",
        "source": "Translation prompt context.",
        "example": "Japanese"
      },
      "targetLanguage": {
        "description": "Target language for translation output.",
        "type": "string",
        "source": "Translation prompt context.",
        "example": "English"
      },
      "objectCount": {
        "description": "Number of objects to translate in the batch.",
        "type": "string",
        "source": "Translation prompt context (unified batch system).",
        "example": "5"
      },
      "mode": {
        "description": "Workspace mode label communicated to the assistant.",
        "type": "string",
        "source": "Chat assistant prefill context (workspace or novelEditor).",
        "example": "workspace"
      },
      "hasFunctions": {
        "description": "Whether the assistant can invoke tool functions in the current chat.",
        "type": "string",
        "source": "Chat assistant prefill context, rendered as yes/no.",
        "example": "yes"
      },
      "targetId": {
        "description": "Identifier for a specific story object being edited.",
        "type": "string",
        "source": "Story object edit context (optional).",
        "example": "character-102"
      }
    },
    "contexts": {
      "contextData": {
        "description": "Formatted markdown describing additional context for edits.",
        "type": "string",
        "source": "Story or chapter edit context data, pre-rendered."
      },
      "currentData": {
        "description": "JSON block representing the current story object data.",
        "type": "string",
        "source": "Story object edit context."
      },
      "userRequest": {
        "description": "User provided request or instructions for the edit.",
        "type": "string",
        "source": "Story/chapter edit contexts."
      },
      "currentContent": {
        "description": "Text block with the current chapter content.",
        "type": "string",
        "source": "Chapter edit context."
      },
      "userInstructions": {
        "description": "Additional user guidance for the translation task.",
        "type": "string",
        "source": "Translation prompt context (optional)."
      },
      "objectsArray": {
        "description": "JSON array of story objects to translate.",
        "type": "string",
        "source": "Translation prompt context (unified batch system)."
      },
      "functionResults": {
        "description": "Summary of recent function call results appended to user messages.",
        "type": "string",
        "source": "User message tag context."
      },
      "storyContext": {
        "description": "Markdown section describing relevant story objects.",
        "type": "string",
        "source": "User message tag context when story data is requested."
      },
      "novelContent": {
        "description": "Markdown section with aggregated novel content.",
        "type": "string",
        "source": "User message tag context when novel content is injected."
      },
      "customSections": {
        "description": "Optional markdown sections provided by the UI for the user tag.",
        "type": "string",
        "source": "User message tag context custom sections."
      }
    },
    "conditionals": {
      "thinking": {
        "description": "Whether the assistant should include an explicit thinking block.",
        "type": "boolean",
        "source": "Chat prompt configuration (custom thinking mode).",
        "supportsNegation": true,
        "default": false
      },
      "targetId": {
        "description": "True when a specific story object target is available.",
        "type": "boolean",
        "source": "Story object edit context.",
        "supportsNegation": true,
        "default": false
      },
      "contextData": {
        "description": "True when supplementary context data was provided and rendered.",
        "type": "boolean",
        "source": "Story/chapter edit contexts.",
        "supportsNegation": true,
        "default": false
      },
      "userRequest": {
        "description": "True when the user supplied explicit edit instructions.",
        "type": "boolean",
        "source": "Story/chapter edit contexts.",
        "supportsNegation": true,
        "default": false
      },
      "userInstructions": {
        "description": "True when the translation request includes supplemental instructions.",
        "type": "boolean",
        "source": "Translation prompt context.",
        "supportsNegation": true,
        "default": false
      }
    }
  },
