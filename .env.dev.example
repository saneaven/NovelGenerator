# Local development (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=novel_buds

# Backend secrets
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-dev
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-dev

# Asset quota (bytes)
DEFAULT_STORAGE_QUOTA_BYTES=524288000
STORAGE_USAGE_RECONCILER_ENABLED=1
STORAGE_USAGE_RECONCILER_INTERVAL_SECONDS=300
STORAGE_USAGE_RECONCILER_BATCH_SIZE=100
STORAGE_USAGE_RECONCILER_STALE_AFTER_SECONDS=86400
STORAGE_USAGE_RECONCILER_ADVISORY_LOCK_KEY=84512001

# Frontend
# Leave empty to use same-origin behind Caddy
VITE_API_URL=
